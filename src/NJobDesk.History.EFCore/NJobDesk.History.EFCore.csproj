<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>NJobDesk.History.EFCore</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NJobDesk.History.EFCore</PackageId>
    <Product>NJobDesk.History.EFCore</Product>
    <Title>NJobDesk EF Core execution history</Title>
    <Description>EF Core execution-history storage for NJobDesk, the scheduler-agnostic jobs dashboard for .NET: persists run history and per-run ILogger output to SQL Server or SQLite, with schema migrations applied at startup, retention cleanup, and stale-run reconciliation. Works with any NJobDesk scheduler provider.</Description>
    <PackageTags>jobs scheduler dashboard history execution-history logging efcore background-jobs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NJobDesk.Core\NJobDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NJobDesk.Tests" />
    <InternalsVisibleTo Include="NJobDesk.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
