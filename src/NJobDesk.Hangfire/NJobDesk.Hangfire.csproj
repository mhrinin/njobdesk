<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>NJobDesk.Hangfire</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NJobDesk.Hangfire</PackageId>
    <Product>NJobDesk.Hangfire</Product>
    <Title>NJobDesk provider for Hangfire</Title>
    <Description>Hangfire provider for NJobDesk, the scheduler-agnostic jobs dashboard for .NET: lists recurring jobs with their cron schedules and last/next runs, and triggers or removes them from the dashboard. Works with any Hangfire storage.</Description>
    <PackageTags>jobs scheduler dashboard hangfire background-jobs recurring-jobs</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NJobDesk.Core\NJobDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NJobDesk.Tests" />
    <InternalsVisibleTo Include="NJobDesk.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
