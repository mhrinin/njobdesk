  "components": {
    "schemas": {
      "CronValidationRequestModel": {
        "required": [
          "cronExpression",
          "nextFireTimeCount"
        ],
        "type": "object",
        "properties": {
          "cronExpression": {
            "type": "string"
          },
          "nextFireTimeCount": {
            "type": "integer",
            "format": "int32"
          },
          "timeZoneId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CronValidationResultModel": {
        "required": [
          "isValid",
          "nextFireTimesUtc"
        ],
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          },
          "nextFireTimesUtc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "additionalProperties": false
      },
      "ExecutionBucketModel": {
        "required": [
          "failed",
          "hourStartUtc",
          "succeeded"
        ],
        "type": "object",
        "properties": {
          "hourStartUtc": {
            "type": "string",
            "format": "date-time"
          },
          "succeeded": {
            "type": "integer",
            "format": "int32"
          },
          "failed": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ExecutionLogLevel": {
        "enum": [
          "Trace",
          "Debug",
          "Information",
          "Warning",
          "Error",
          "Critical"
        ],
        "type": "string"
      },
      "ExecutionLogModel": {
        "required": [
          "category",
          "level",
          "message",
          "timestampUtc"
        ],
        "type": "object",
        "properties": {
          "timestampUtc": {
            "type": "string",
            "format": "date-time"
          },
          "level": {
            "$ref": "#/components/schemas/ExecutionLogLevel"
          },
          "category": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "exception": {
            "type": "string",
            "nullable": true
          },
          "properties": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ExecutionModel": {
        "required": [
          "id",
          "jobGroup",
          "jobName",
          "recovering",
          "schedulerInstanceId",
          "startedUtc",
          "state",
          "triggerGroup",
          "triggerName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "jobGroup": {
            "type": "string"
          },
          "jobName": {
            "type": "string"
          },
          "triggerGroup": {
            "type": "string"
          },
          "triggerName": {
            "type": "string"
          },
          "startedUtc": {
            "type": "string",
            "format": "date-time"
          },
          "finishedUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "durationMs": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "state": {
            "$ref": "#/components/schemas/ExecutionStatus"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "schedulerInstanceId": {
            "type": "string"
          },
          "recovering": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ExecutionModelPagedResult": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExecutionModel"
            }
          }
        },
        "additionalProperties": false
      },
      "ExecutionStatus": {
        "enum": [
          "Running",
          "Succeeded",
          "Failed",
          "Vetoed"
        ],
        "type": "string"
      },
      "JobDetailModel": {
        "required": [
          "job",
          "recentExecutions",
          "triggers"
        ],
        "type": "object",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/JobSummaryModel"
          },
          "triggers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TriggerModel"
            }
          },
          "recentExecutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExecutionModel"
            }
          }
        },
        "additionalProperties": false
      },
      "JobState": {
        "enum": [
          "None",
          "Normal",
          "Paused",
          "Blocked",
          "Error",
          "Complete"
        ],
        "type": "string"
      },
      "JobSummaryModel": {
        "required": [
          "concurrentExecutionDisallowed",
          "durable",
          "group",
          "isSystemJob",
          "name",
          "state",
          "triggerCount"
        ],
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "jobType": {
            "type": "string",
            "nullable": true
          },
          "durable": {
            "type": "boolean"
          },
          "concurrentExecutionDisallowed": {
            "type": "boolean"
          },
          "triggerCount": {
            "type": "integer",
            "format": "int32"
          },
          "scheduleSummary": {
            "type": "string",
            "nullable": true
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "nextFireTimeUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "previousFireTimeUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isSystemJob": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "JobSummaryModelPagedResult": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobSummaryModel"
            }
          }
